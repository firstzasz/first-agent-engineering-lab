diff --git a/tests/test_pause.py b/tests/test_pause.py
new file mode 100644
index 0000000..315c645
--- /dev/null
+++ b/tests/test_pause.py
@@ -0,0 +1,159 @@
+import sqlite3
+import unittest
+
+from relayboard import JobNotSchedulable, Store
+from relayboard.testing import request
+from relayboard.web import create_seeded_app
+
+
+class PauseTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.app = create_seeded_app()
+
+    def test_pause_blocks_scheduling_until_resume_without_creating_runs(self):
+        for _ in range(2):
+            code, payload = request(
+                self.app, "POST", "/api/jobs/daily-report/pause"
+            )
+            self.assertEqual(code, 200)
+            self.assertTrue(payload["job"]["paused"])
+            self.assertTrue(payload["job"]["enabled"])
+
+        with self.assertRaises(JobNotSchedulable):
+            self.app.service.begin_scheduled_run("daily-report")
+        code, payload = request(
+            self.app, "POST", "/api/jobs/daily-report/runs",
+            {"source": "scheduled"},
+        )
+        self.assertEqual(code, 409)
+        self.assertIn("paused", payload["error"])
+        self.assertEqual(self.app.store.next_run_id(), "run-001")
+        self.assertEqual(self.app.store.list_alerts(), [])
+
+        code, payload = request(self.app, "GET", "/api/jobs")
+        self.assertEqual(code, 200)
+        self.assertTrue(next(
+            job for job in payload["jobs"] if job["id"] == "daily-report"
+        )["paused"])
+
+        for _ in range(2):
+            code, payload = request(
+                self.app, "POST", "/api/jobs/daily-report/resume"
+            )
+            self.assertEqual(code, 200)
+            self.assertFalse(payload["job"]["paused"])
+        code, payload = request(
+            self.app, "POST", "/api/jobs/daily-report/runs",
+            {"source": "scheduled"},
+        )
+        self.assertEqual(code, 201)
+        self.assertEqual(payload["run"]["id"], "run-001")
+
+    def test_pause_and_resume_preserve_enabled_setting(self):
+        for job_id in ("daily-report", "cleanup"):
+            with self.subTest(job_id=job_id):
+                before = self.app.store.get_job(job_id)
+                self.app.service.pause_job(job_id)
+                after = self.app.service.resume_job(job_id)
+                self.assertEqual(before, after)
+        with self.assertRaises(JobNotSchedulable):
+            self.app.service.begin_scheduled_run("cleanup")
+
+        self.app.service.pause_job("cleanup")
+        request(self.app, "POST", "/api/jobs/cleanup/enabled", {"enabled": True})
+        self.assertTrue(self.app.store.get_job("cleanup").paused)
+        with self.assertRaises(JobNotSchedulable):
+            self.app.service.begin_scheduled_run("cleanup")
+        self.app.service.resume_job("cleanup")
+        self.assertEqual(
+            self.app.service.begin_scheduled_run("cleanup").source, "scheduled"
+        )
+
+    def test_manual_runs_and_active_runs_keep_retries_and_alerts(self):
+        for source in ("manual", "scheduled"):
+            for final_success in (True, False):
+                with self.subTest(source=source, final_success=final_success):
+                    traces = []
+                    for paused in (False, True):
+                        app = create_seeded_app()
+                        if paused and source == "manual":
+                            app.service.pause_job("daily-report")
+                        code, payload = request(
+                            app, "POST", "/api/jobs/daily-report/runs",
+                            {"source": source},
+                        )
+                        self.assertEqual(code, 201)
+                        run_id = payload["run"]["id"]
+                        if paused and source == "scheduled":
+                            app.service.pause_job("daily-report")
+                        states = [
+                            app.service.record_attempt(run_id, succeeded=False),
+                            app.service.record_attempt(
+                                run_id, succeeded=final_success
+                            ),
+                        ]
+                        self.assertEqual(states[0], "retry")
+                        self.assertEqual(
+                            states[1], "succeeded" if final_success else "failed"
+                        )
+                        traces.append((
+                            states, app.store.get_run(run_id),
+                            app.store.list_attempts(run_id),
+                            app.store.list_alerts(),
+                        ))
+                    self.assertEqual(traces[0], traces[1])
+
+    def test_dashboard_preserves_result_and_shows_pause_separately(self):
+        run = self.app.service.begin_manual_run("daily-report")
+        self.app.service.record_attempt(run.id, succeeded=True)
+        self.app.service.pause_job("daily-report")
+        code, markup = request(self.app, "GET", "/dashboard")
+        self.assertEqual(code, 200)
+        self.assertIn("<th>Enabled</th><th>Paused</th><th>Last result</th>", markup)
+        self.assertIn(
+            "<td>Daily report</td><td>yes</td><td>yes</td><td>succeeded</td>",
+            markup,
+        )
+
+    def test_pause_state_survives_store_reconstruction(self):
+        self.app.service.pause_job("daily-report")
+        reopened = Store(self.app.store.connection)
+        self.assertTrue(reopened.get_job("daily-report").paused)
+        self.assertFalse(reopened.get_job("cleanup").paused)
+
+    def test_existing_schema_gets_unpaused_default(self):
+        connection = sqlite3.connect(":memory:")
+        connection.executescript("""
+            CREATE TABLE jobs (
+                id TEXT PRIMARY KEY, name TEXT NOT NULL,
+                enabled INTEGER NOT NULL, max_attempts INTEGER NOT NULL
+            );
+            INSERT INTO jobs VALUES ('legacy', 'Legacy', 0, 3);
+        """)
+        store = Store(connection)
+        job = store.get_job("legacy")
+        self.assertFalse(job.paused)
+        self.assertFalse(job.enabled)
+        self.assertEqual(job.max_attempts, 3)
+        store.set_job_paused("legacy", True)
+        self.assertTrue(Store(connection).get_job("legacy").paused)
+
+    def test_unknown_jobs_and_nonmatching_routes_return_404(self):
+        before = self.app.store.list_jobs()
+        for action in ("pause", "resume"):
+            code, payload = request(
+                self.app, "POST", f"/api/jobs/missing/{action}"
+            )
+            self.assertEqual(code, 404)
+            self.assertEqual(payload, {"error": "not found: missing"})
+            for method, path in (
+                ("GET", f"/api/jobs/daily-report/{action}"),
+                ("POST", f"/api/jobs/daily-report/extra/{action}"),
+            ):
+                code, _ = request(self.app, method, path)
+                self.assertEqual(code, 404)
+        self.assertEqual(self.app.store.list_jobs(), before)
+
+
+if __name__ == "__main__":
+    unittest.main()
