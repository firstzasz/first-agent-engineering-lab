diff --git a/tests/test_pause.py b/tests/test_pause.py
new file mode 100644
index 0000000..249f216
--- /dev/null
+++ b/tests/test_pause.py
@@ -0,0 +1,179 @@
+import sqlite3
+import unittest
+
+from relayboard.service import JobNotSchedulable
+from relayboard.store import Store
+from relayboard.testing import request
+from relayboard.web import create_seeded_app
+
+
+class JobPauseTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.app = create_seeded_app()
+
+    def test_pause_and_resume_control_scheduled_work(self) -> None:
+        code, payload = request(
+            self.app, "POST", "/api/jobs/daily-report/pause"
+        )
+        self.assertEqual(code, 200)
+        self.assertTrue(payload["job"]["paused"])
+        with self.assertRaises(JobNotSchedulable):
+            self.app.service.begin_scheduled_run("daily-report")
+
+        code, payload = request(
+            self.app, "POST", "/api/jobs/daily-report/runs",
+            {"source": "scheduled"},
+        )
+        self.assertEqual(code, 409)
+        self.assertIn("paused", payload["error"])
+        code, payload = request(
+            self.app, "POST", "/api/jobs/daily-report/resume"
+        )
+        self.assertEqual(code, 200)
+        self.assertFalse(payload["job"]["paused"])
+        code, payload = request(
+            self.app, "POST", "/api/jobs/daily-report/runs",
+            {"source": "scheduled"},
+        )
+        self.assertEqual(code, 201)
+        self.assertEqual(payload["run"]["id"], "run-001")
+
+    def test_unknown_job_uses_existing_not_found_convention(self) -> None:
+        for action in ("pause", "resume"):
+            with self.subTest(action=action):
+                code, payload = request(
+                    self.app, "POST", f"/api/jobs/missing/{action}"
+                )
+                self.assertEqual(code, 404)
+                self.assertEqual(payload, {"error": "not found: missing"})
+
+    def test_new_jobs_default_to_unpaused(self) -> None:
+        self.assertFalse(self.app.store.get_job("daily-report").paused)
+        code, payload = request(self.app, "GET", "/api/jobs")
+        self.assertEqual(code, 200)
+        self.assertTrue(all(not job["paused"] for job in payload["jobs"]))
+
+    def test_manual_runs_remain_allowed_while_paused(self) -> None:
+        self.app.service.pause_job("daily-report")
+        code, payload = request(
+            self.app, "POST", "/api/jobs/daily-report/runs"
+        )
+        self.assertEqual(code, 201)
+        self.assertEqual(payload["run"]["source"], "manual")
+
+    def test_existing_runs_preserve_retries_outcomes_and_alerts(self) -> None:
+        for source in ("manual", "scheduled"):
+            for outcomes in ((False, True), (False, False)):
+                with self.subTest(source=source, outcomes=outcomes):
+                    snapshots = []
+                    for paused in (False, True):
+                        app = create_seeded_app()
+                        begin = (
+                            app.service.begin_manual_run
+                            if source == "manual"
+                            else app.service.begin_scheduled_run
+                        )
+                        run = begin("daily-report")
+                        if paused:
+                            app.service.pause_job("daily-report")
+                        states = [
+                            app.service.record_attempt(run.id, succeeded=outcome)
+                            for outcome in outcomes
+                        ]
+                        snapshots.append((
+                            states,
+                            app.store.get_run(run.id),
+                            app.store.list_attempts(run.id),
+                            app.store.list_alerts(),
+                        ))
+                    self.assertEqual(snapshots[0], snapshots[1])
+                    self.assertEqual(snapshots[1][0][0], "retry")
+                    self.assertEqual(
+                        snapshots[1][1].status,
+                        "succeeded" if outcomes[-1] else "failed",
+                    )
+
+    def test_pause_is_independent_of_enabled_and_requests_are_idempotent(self) -> None:
+        for job_id in ("daily-report", "cleanup"):
+            with self.subTest(job_id=job_id):
+                original = self.app.store.get_job(job_id)
+                for action, paused in (("pause", True), ("resume", False)):
+                    responses = [
+                        request(self.app, "POST", f"/api/jobs/{job_id}/{action}")
+                        for _ in range(2)
+                    ]
+                    self.assertEqual(responses[0], responses[1])
+                    self.assertEqual(responses[0][0], 200)
+                    job = self.app.store.get_job(job_id)
+                    self.assertEqual(job.enabled, original.enabled)
+                    self.assertEqual(job.paused, paused)
+                    self.assertEqual(job.max_attempts, original.max_attempts)
+        with self.assertRaises(JobNotSchedulable):
+            self.app.service.begin_scheduled_run("cleanup")
+
+        self.app.service.pause_job("daily-report")
+        for enabled in (False, True):
+            code, payload = request(
+                self.app, "POST", "/api/jobs/daily-report/enabled",
+                {"enabled": enabled},
+            )
+            self.assertEqual(code, 200)
+            self.assertTrue(payload["job"]["paused"])
+            with self.assertRaises(JobNotSchedulable):
+                self.app.service.begin_scheduled_run("daily-report")
+
+    def test_dashboard_keeps_last_result_and_shows_pause_state(self) -> None:
+        run = self.app.service.begin_manual_run("daily-report")
+        self.app.service.record_attempt(run.id, succeeded=True)
+        self.app.service.pause_job("daily-report")
+        code, body = request(self.app, "GET", "/dashboard")
+        self.assertEqual(code, 200)
+        self.assertIn("<th>Paused</th>", body)
+        self.assertIn(
+            "<td>Daily report</td><td>yes</td><td>yes</td><td>succeeded</td>",
+            body,
+        )
+        self.app.service.resume_job("daily-report")
+        self.assertIn(
+            "<td>Daily report</td><td>yes</td><td>no</td><td>succeeded</td>",
+            self.app.render_dashboard(),
+        )
+
+    def test_pause_state_survives_store_reopening(self) -> None:
+        self.app.service.pause_job("daily-report")
+        reopened = Store(self.app.store.connection)
+        self.assertTrue(reopened.get_job("daily-report").paused)
+
+    def test_pause_routes_require_post_and_exact_job_path(self) -> None:
+        for method, path in (
+            ("GET", "/api/jobs/daily-report/pause"),
+            ("POST", "/api/jobs/daily-report/extra/pause"),
+            ("POST", "/api/jobs//pause"),
+        ):
+            with self.subTest(method=method, path=path):
+                code, _ = request(self.app, method, path)
+                self.assertEqual(code, 404)
+                self.assertFalse(self.app.store.get_job("daily-report").paused)
+
+    def test_existing_database_is_migrated_without_losing_jobs(self) -> None:
+        connection = sqlite3.connect(":memory:")
+        self.addCleanup(connection.close)
+        connection.execute(
+            "CREATE TABLE jobs (id TEXT PRIMARY KEY, name TEXT NOT NULL, "
+            "enabled INTEGER NOT NULL, max_attempts INTEGER NOT NULL)"
+        )
+        connection.execute(
+            "INSERT INTO jobs VALUES ('legacy', 'Legacy', 0, 3)"
+        )
+        connection.commit()
+        store = Store(connection)
+        job = store.get_job("legacy")
+        self.assertFalse(job.paused)
+        self.assertFalse(job.enabled)
+        self.assertEqual(job.max_attempts, 3)
+        # Reopening an already migrated database must also work.
+        self.assertEqual(Store(connection).get_job("legacy"), job)
+
+
+if __name__ == "__main__":
+    unittest.main()
