diff --git a/tests/test_pause.py b/tests/test_pause.py
new file mode 100644
index 0000000..ade0bfe
--- /dev/null
+++ b/tests/test_pause.py
@@ -0,0 +1,126 @@
+import sqlite3
+import unittest
+
+from relayboard.service import JobNotSchedulable
+from relayboard.store import Store
+from relayboard.testing import request
+from relayboard.web import create_seeded_app
+
+
+class PauseTests(unittest.TestCase):
+    def setUp(self):
+        self.app = create_seeded_app()
+
+    def test_pause_blocks_scheduled_runs_until_resume(self):
+        service = self.app.service
+        self.assertFalse(self.app.store.get_job("daily-report").paused)
+        self.assertTrue(service.pause_job("daily-report").paused)
+        with self.assertRaisesRegex(JobNotSchedulable, "paused"):
+            service.begin_scheduled_run("daily-report")
+        self.assertEqual(self.app.store.next_run_id(), "run-001")
+        self.assertEqual(self.app.store.list_alerts(), [])
+        self.assertFalse(service.resume_job("daily-report").paused)
+        run = service.begin_scheduled_run("daily-report")
+        self.assertEqual(run.source, "scheduled")
+
+    def test_api_pause_resume_are_idempotent_and_visible(self):
+        for action, paused in (("pause", True), ("resume", False)):
+            for _ in range(2):
+                code, payload = request(
+                    self.app, "POST", f"/api/jobs/daily-report/{action}"
+                )
+                self.assertEqual(code, 200)
+                self.assertEqual(payload["job"], {
+                    "id": "daily-report", "name": "Daily report",
+                    "enabled": True, "max_attempts": 2, "paused": paused,
+                })
+                code, payload = request(self.app, "GET", "/api/jobs")
+                self.assertEqual(code, 200)
+                job = next(j for j in payload["jobs"] if j["id"] == "daily-report")
+                self.assertEqual(job["paused"], paused)
+        self.assertEqual(self.app.store.next_run_id(), "run-001")
+
+    def test_paused_api_scheduled_run_conflicts_but_manual_run_works(self):
+        request(self.app, "POST", "/api/jobs/daily-report/pause")
+        code, payload = request(
+            self.app, "POST", "/api/jobs/daily-report/runs", {"source": "scheduled"}
+        )
+        self.assertEqual(code, 409)
+        self.assertIn("paused", payload["error"])
+        code, payload = request(self.app, "POST", "/api/jobs/daily-report/runs")
+        self.assertEqual(code, 201)
+        self.assertEqual(payload["run"]["source"], "manual")
+
+    def test_enabled_and_paused_states_are_independent(self):
+        service = self.app.service
+        service.pause_job("cleanup")
+        service.resume_job("cleanup")
+        self.assertFalse(self.app.store.get_job("cleanup").enabled)
+        with self.assertRaisesRegex(JobNotSchedulable, "disabled"):
+            service.begin_scheduled_run("cleanup")
+        service.pause_job("cleanup")
+        service.set_job_enabled("cleanup", True)
+        with self.assertRaisesRegex(JobNotSchedulable, "paused"):
+            service.begin_scheduled_run("cleanup")
+        service.resume_job("cleanup")
+        self.assertEqual(service.begin_scheduled_run("cleanup").source, "scheduled")
+
+    def test_existing_runs_retries_and_alerts_continue(self):
+        for final_success in (True, False):
+            with self.subTest(final_success=final_success):
+                app = create_seeded_app()
+                run = app.service.begin_scheduled_run("daily-report")
+                app.service.pause_job("daily-report")
+                self.assertEqual(app.service.record_attempt(run.id, succeeded=False), "retry")
+                # Preserve existing alert behavior, including intermediate failures.
+                self.assertEqual(len(app.store.list_alerts()), 1)
+                final_status = "succeeded" if final_success else "failed"
+                self.assertEqual(
+                    app.service.record_attempt(run.id, succeeded=final_success), final_status
+                )
+                self.assertEqual(app.store.get_run(run.id).status, final_status)
+                self.assertEqual(len(app.store.list_attempts(run.id)), 2)
+                self.assertEqual(len(app.store.list_alerts()), 1 if final_success else 2)
+                self.assertTrue(app.store.get_job("daily-report").paused)
+
+    def test_pause_preserves_dashboard_last_result(self):
+        run = self.app.service.begin_manual_run("daily-report")
+        self.app.service.record_attempt(run.id, succeeded=True)
+        self.app.service.pause_job("daily-report")
+        code, dashboard = request(self.app, "GET", "/dashboard")
+        self.assertEqual(code, 200)
+        self.assertIn("<th>Enabled</th><th>Paused</th><th>Last result</th>", dashboard)
+        self.assertIn("<td>Daily report</td><td>yes</td><td>yes</td><td>succeeded</td>", dashboard)
+
+    def test_unknown_jobs_and_invalid_routes(self):
+        for action in ("pause", "resume"):
+            code, payload = request(self.app, "POST", f"/api/jobs/missing/{action}")
+            self.assertEqual(code, 404)
+            self.assertEqual(payload, {"error": "not found: missing"})
+            code, _ = request(self.app, "GET", f"/api/jobs/daily-report/{action}")
+            self.assertEqual(code, 404)
+            code, _ = request(self.app, "POST", f"/api/jobs/daily-report/extra/{action}")
+            self.assertEqual(code, 404)
+        self.assertFalse(self.app.store.get_job("daily-report").paused)
+
+    def test_existing_database_migrates_and_keeps_paused_state(self):
+        connection = sqlite3.connect(":memory:")
+        self.addCleanup(connection.close)
+        connection.executescript("""
+            CREATE TABLE jobs (
+                id TEXT PRIMARY KEY, name TEXT NOT NULL, enabled INTEGER NOT NULL,
+                max_attempts INTEGER NOT NULL CHECK(max_attempts >= 1)
+            );
+            INSERT INTO jobs VALUES ('existing', 'Existing', 1, 2);
+        """)
+        store = Store(connection)
+        self.assertFalse(store.get_job("existing").paused)
+        store.set_job_paused("existing", True)
+        reopened = Store(connection)
+        self.assertTrue(reopened.get_job("existing").paused)
+        self.assertTrue(reopened.list_jobs()[0].paused)
+        self.assertTrue(reopened.get_job("existing").enabled)
+
+
+if __name__ == "__main__":
+    unittest.main()
