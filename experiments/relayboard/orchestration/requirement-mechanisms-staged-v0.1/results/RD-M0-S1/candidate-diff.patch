diff --git a/tests/test_pause.py b/tests/test_pause.py
new file mode 100644
index 0000000..704ce0c
--- /dev/null
+++ b/tests/test_pause.py
@@ -0,0 +1,152 @@
+import sqlite3
+import tempfile
+import unittest
+from pathlib import Path
+
+from relayboard.service import JobNotSchedulable
+from relayboard.store import Store
+from relayboard.testing import request
+from relayboard.web import create_seeded_app
+
+
+class PauseTests(unittest.TestCase):
+    def setUp(self):
+        self.app = create_seeded_app()
+
+    def post(self, action, job_id="daily-report"):
+        return request(self.app, "POST", f"/api/jobs/{job_id}/{action}")
+
+    def test_pause_blocks_scheduled_work_until_resume(self):
+        code, payload = self.post("pause")
+        self.assertEqual(code, 200)
+        self.assertTrue(payload["job"]["paused"])
+        self.assertTrue(payload["job"]["enabled"])
+        code, payload = request(
+            self.app, "POST", "/api/jobs/daily-report/runs",
+            {"source": "scheduled"},
+        )
+        self.assertEqual(code, 409)
+        self.assertIn("paused", payload["error"])
+        self.assertEqual(self.app.store.next_run_id(), "run-001")
+        self.assertEqual(self.app.store.list_alerts(), [])
+
+        code, payload = self.post("resume")
+        self.assertEqual(code, 200)
+        self.assertFalse(payload["job"]["paused"])
+        code, payload = request(
+            self.app, "POST", "/api/jobs/daily-report/runs",
+            {"source": "scheduled"},
+        )
+        self.assertEqual(code, 201)
+        self.assertEqual(payload["run"]["source"], "scheduled")
+
+    def test_manual_work_allowed_while_paused(self):
+        self.post("pause")
+        code, payload = request(
+            self.app, "POST", "/api/jobs/daily-report/runs", {},
+        )
+        self.assertEqual(code, 201)
+        self.assertEqual(payload["run"]["source"], "manual")
+
+    def test_existing_runs_retries_and_alerts_unchanged(self):
+        for terminal_success in (False, True):
+            with self.subTest(terminal_success=terminal_success):
+                results = []
+                for paused in (False, True):
+                    app = create_seeded_app()
+                    run = app.service.begin_scheduled_run("daily-report")
+                    if paused:
+                        app.service.pause_job("daily-report")
+                    self.assertEqual(app.service.record_attempt(run.id, succeeded=False), "retry")
+                    app.service.record_attempt(run.id, succeeded=terminal_success)
+                    results.append((
+                        app.store.get_run(run.id),
+                        app.store.list_attempts(run.id),
+                        app.store.list_alerts(),
+                    ))
+                self.assertEqual(results[0], results[1])
+
+    def test_pause_is_independent_of_enabled(self):
+        self.post("pause", "cleanup")
+        self.post("resume", "cleanup")
+        self.assertFalse(self.app.store.get_job("cleanup").enabled)
+        with self.assertRaises(JobNotSchedulable):
+            self.app.service.begin_scheduled_run("cleanup")
+
+        self.post("pause")
+        for enabled in (False, True):
+            code, payload = request(
+                self.app, "POST", "/api/jobs/daily-report/enabled",
+                {"enabled": enabled},
+            )
+            self.assertEqual(code, 200)
+            self.assertTrue(payload["job"]["paused"])
+            with self.assertRaises(JobNotSchedulable):
+                self.app.service.begin_scheduled_run("daily-report")
+
+    def test_actions_are_idempotent_and_unknown_jobs_return_404(self):
+        for action, paused in (("resume", False), ("pause", True), ("resume", False)):
+            for _ in range(2):
+                code, payload = self.post(action)
+                self.assertEqual(code, 200)
+                self.assertEqual(payload["job"]["paused"], paused)
+            code, payload = self.post(action, "missing")
+            self.assertEqual(code, 404)
+            self.assertEqual(payload, {"error": "not found: missing"})
+
+    def test_get_jobs_and_dashboard_show_pause_without_changing_last_result(self):
+        run = self.app.service.begin_manual_run("daily-report")
+        self.app.service.record_attempt(run.id, succeeded=True)
+        self.post("pause")
+        code, payload = request(self.app, "GET", "/api/jobs")
+        self.assertEqual(code, 200)
+        jobs = {job["id"]: job for job in payload["jobs"]}
+        self.assertTrue(jobs["daily-report"]["paused"])
+        self.assertFalse(jobs["cleanup"]["paused"])
+        code, markup = request(self.app, "GET", "/dashboard")
+        self.assertEqual(code, 200)
+        self.assertIn("<th>Paused</th>", markup)
+        self.assertIn("<td>Daily report</td><td>yes</td><td>yes</td><td>succeeded</td>", markup)
+        self.assertEqual(self.app.store.last_result_for_job("daily-report"), "succeeded")
+
+    def test_pause_routes_require_exact_path_and_post(self):
+        for method, path in (
+            ("GET", "/api/jobs/daily-report/pause"),
+            ("POST", "/api/jobs/daily-report/extra/pause"),
+            ("POST", "/api/jobs//pause"),
+        ):
+            code, _ = request(self.app, method, path)
+            self.assertEqual(code, 404)
+        self.assertFalse(self.app.store.get_job("daily-report").paused)
+
+
+class PauseStorageTests(unittest.TestCase):
+    def test_upgrade_and_persistence(self):
+        with tempfile.TemporaryDirectory(dir=Path(__file__).parent) as directory:
+            database = Path(directory) / "relayboard.sqlite"
+            connection = sqlite3.connect(database)
+            connection.executescript("""
+                CREATE TABLE jobs (
+                    id TEXT PRIMARY KEY, name TEXT NOT NULL,
+                    enabled INTEGER NOT NULL, max_attempts INTEGER NOT NULL
+                );
+                INSERT INTO jobs VALUES ('legacy', 'Legacy', 1, 2);
+            """)
+            store = Store(connection)
+            self.assertFalse(store.get_job("legacy").paused)
+            store.set_job_paused("legacy", True)
+            connection.close()
+
+            connection = sqlite3.connect(database)
+            try:
+                store = Store(connection)
+                self.assertTrue(store.get_job("legacy").paused)
+                self.assertTrue(store.get_job("legacy").enabled)
+                self.assertEqual(store.get_job("legacy").max_attempts, 2)
+                self.assertFalse(store.add_job("new", "New").paused)
+            finally:
+                connection.close()
+
+
+if __name__ == "__main__":
+    unittest.main()
