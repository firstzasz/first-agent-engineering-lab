++                                         {"source": "scheduled"})[0], 409)
++            finally:
++                reopened.close()
++
++    def test_dashboard_shows_pause_beside_existing_job_state(self) -> None:
++        request(self.app, "POST", "/api/jobs/daily-report/pause")
