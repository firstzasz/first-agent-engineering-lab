+14:     def _create_schema(self) -> None:
+15:         self.connection.executescript(
+16:             """
+17:             CREATE TABLE IF NOT EXISTS jobs (
+18:                 id TEXT PRIMARY KEY,
+19:                 name TEXT NOT NULL,
+20:                 enabled INTEGER NOT NULL,
+21:                 max_attempts INTEGER NOT NULL CHECK(max_attempts >= 1)
+22:             );
+23:             CREATE TABLE IF NOT EXISTS runs (
+24:                 id TEXT PRIMARY KEY,
+25:                 job_id TEXT NOT NULL REFERENCES jobs(id),
+26:                 source TEXT NOT NULL CHECK(source IN ('manual', 'scheduled')),
+27:                 status TEXT NOT NULL CHECK(status IN ('running', 'succeeded', 'failed'))
+28:             );
+29:             CREATE TABLE IF NOT EXISTS attempts (
+30:                 run_id TEXT NOT NULL REFERENCES runs(id),
+31:                 number INTEGER NOT NULL,
+32:                 succeeded INTEGER NOT NULL,
+33:                 PRIMARY KEY (run_id, number)
+34:             );
+35:             CREATE TABLE IF NOT EXISTS alerts (
+36:                 id INTEGER PRIMARY KEY AUTOINCREMENT,
+37:                 run_id TEXT NOT NULL REFERENCES runs(id),
+38:                 job_id TEXT NOT NULL REFERENCES jobs(id),
+39:                 kind TEXT NOT NULL,
+40:                 message TEXT NOT NULL
+41:             );
+42:             """
+43:         )
+44:         self.connection.commit()
+45: 
+46:     def add_job(
+47:         self,
+48:         job_id: str,
+49:         name: str,
+50:         *,
+51:         enabled: bool = True,
+52:         max_attempts: int = 1,
+53:     ) -> Job:
+54:         self.connection.execute(
+55:             "INSERT INTO jobs(id, name, enabled, max_attempts) VALUES (?, ?, ?, ?)",
+56:             (job_id, name, int(enabled), max_attempts),
+57:         )
+58:         self.connection.commit()
+59:         return self.get_job(job_id)
+60: 
+61:     def get_job(self, job_id: str) -> Job:
+62:         row = self.connection.execute(
+63:             "SELECT * FROM jobs WHERE id = ?",
+64:             (job_id,),
+65:         ).fetchone()
+66:         if row is None:
+67:             raise KeyError(job_id)
+68:         return Job(
+69:             row["id"],
+70:             row["name"],
+71:             bool(row["enabled"]),
+72:             row["max_attempts"],
+73:         )
+74: 
+75:     def list_jobs(self) -> list[Job]:
+76:         rows = self.connection.execute(
+77:             "SELECT * FROM jobs ORDER BY id"
+78:         ).fetchall()
+79:         return [
+80:             Job(r["id"], r["name"], bool(r["enabled"]), r["max_attempts"])
+81:             for r in rows
+82:         ]
+83: 
+84:     def set_job_enabled(self, job_id: str, enabled: bool) -> Job:
+85:         self.get_job(job_id)
+86:         self.connection.execute(
+87:             "UPDATE jobs SET enabled = ? WHERE id = ?",
+88:             (int(enabled), job_id),
+89:         )
+90:         self.connection.commit()
+91:         return self.get_job(job_id)
+92: 
+93:     def next_run_id(self) -> str:
+94:         row = self.connection.execute(
+95:             "SELECT COUNT(*) AS n FROM runs"
+96:         ).fetchone()
+97:         return f"run-{row['n'] + 1:03d}"
+98: 
+99:     def create_run(self, job_id: str, source: str) -> Run:
+100:         self.get_job(job_id)
+101:         run_id = self.next_run_id()
+102:         self.connection.execute(
+103:             "INSERT INTO runs(id, job_id, source, status) VALUES (?, ?, ?, 'running')",
+104:             (run_id, job_id, source),
+105:         )
+106:         self.connection.commit()
+107:         return self.get_run(run_id)
+108: 
+109:     def get_run(self, run_id: str) -> Run:
+110:         row = self.connection.execute(
+111:             "SELECT * FROM runs WHERE id = ?",
+112:             (run_id,),
+113:         ).fetchone()
+114:         if row is None:
+115:             raise KeyError(run_id)
+116:         return Run(
+117:             row["id"],
+118:             row["job_id"],
+119:             row["source"],
+120:             row["status"],
+121:         )
+122: 
+123:     def set_run_status(self, run_id: str, status: str) -> Run:
+124:         self.get_run(run_id)
+125:         self.connection.execute(
+126:             "UPDATE runs SET status = ? WHERE id = ?",
+127:             (status, run_id),
+128:         )
+129:         self.connection.commit()
+130:         return self.get_run(run_id)
+131: 
+132:     def add_attempt(self, run_id: str, succeeded: bool) -> Attempt:
+133:         self.get_run(run_id)
+134:         row = self.connection.execute(
+135:             "SELECT COUNT(*) AS n FROM attempts WHERE run_id = ?",
+136:             (run_id,),
+137:         ).fetchone()
+138:         number = row["n"] + 1
+139:         self.connection.execute(
+140:             "INSERT INTO attempts(run_id, number, succeeded) VALUES (?, ?, ?)",
+141:             (run_id, number, int(succeeded)),
+142:         )
+143:         self.connection.commit()
+144:         return Attempt(run_id, number, succeeded)
+145: 
+146:     def list_attempts(self, run_id: str) -> list[Attempt]:
+147:         rows = self.connection.execute(
+148:             "SELECT * FROM attempts WHERE run_id = ? ORDER BY number",
+149:             (run_id,),
+150:         ).fetchall()
+151:         return [
+152:             Attempt(r["run_id"], r["number"], bool(r["succeeded"]))
+153:             for r in rows
+154:         ]
+155: 
+156:     def add_alert(
+157:         self,
+158:         run_id: str,
+159:         job_id: str,
+160:         kind: str,
+161:         message: str,
+162:     ) -> Alert:
+163:         cur = self.connection.execute(
+164:             "INSERT INTO alerts(run_id, job_id, kind, message) VALUES (?, ?, ?, ?)",
+165:             (run_id, job_id, kind, message),
+166:         )
+167:         self.connection.commit()
+168:         return Alert(cur.lastrowid, run_id, job_id, kind, message)
+169: 
+170:     def list_alerts(self) -> list[Alert]:
+171:         rows = self.connection.execute(
+172:             "SELECT * FROM alerts ORDER BY id"
+173:         ).fetchall()
+174:         return [
+175:             Alert(
+176:                 r["id"],
+177:                 r["run_id"],
+178:                 r["job_id"],
