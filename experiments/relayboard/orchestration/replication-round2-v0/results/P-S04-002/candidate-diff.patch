+1: from __future__ import annotations
+2: 
+3: from .models import Run
+4: from .store import Store
+5: 
+6: 
+7: class JobNotSchedulable(RuntimeError):
+8:     pass
+9: 
+10: 
+11: class RunAlreadyTerminal(RuntimeError):
+12:     pass
+13: 
+14: 
+15: class RelayBoardService:
+16:     def __init__(self, store: Store) -> None:
+17:         self.store = store
+18: 
+19:     def begin_manual_run(self, job_id: str) -> Run:
+20:         self.store.get_job(job_id)
+21:         return self.store.create_run(job_id, "manual")
+22: 
+23:     def begin_scheduled_run(self, job_id: str) -> Run:
+24:         job = self.store.get_job(job_id)
+25:         if not job.enabled:
+26:             raise JobNotSchedulable(f"job {job_id} is disabled")
+27:         return self.store.create_run(job_id, "scheduled")
+28: 
+29:     def set_job_enabled(self, job_id: str, enabled: bool) -> None:
+30:         self.store.set_job_enabled(job_id, enabled)
+31: 
+32:     def record_attempt(self, run_id: str, *, succeeded: bool) -> str:
+33:         run = self.store.get_run(run_id)
+34:         if run.status != "running":
+35:             raise RunAlreadyTerminal(run_id)
+36: 
+37:         job = self.store.get_job(run.job_id)
+38:         attempt = self.store.add_attempt(run_id, succeeded)
+39: 
+40:         if succeeded:
+41:             self.store.set_run_status(run_id, "succeeded")
+42:             return "succeeded"
+43: 
+44:         if attempt.number < job.max_attempts:
+45:             return "retry"
+46: 
+47:         self.store.set_run_status(run_id, "failed")
+48:         self._emit_failure_alert(run_id)
+49:         return "failed"
+50: 
+51:     def _emit_failure_alert(self, run_id: str) -> None:
+52:         run = self.store.get_run(run_id)
+53:         job = self.store.get_job(run.job_id)
+54:         self.store.add_alert(
+55:             run.id,
+56:             job.id,
+57:             "run_failed",
+58:             f"Job {job.name} failed for run {run.id}",
+59:         )
