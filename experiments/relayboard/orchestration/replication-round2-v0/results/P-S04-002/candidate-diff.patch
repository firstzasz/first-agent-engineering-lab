+8: class Store:
+9:     def __init__(self, connection: sqlite3.Connection | None = None) -> None:
+10:         self.connection = connection or sqlite3.connect(":memory:")
+11:         self.connection.row_factory = sqlite3.Row
+12:         self._create_schema()
