diff --git a/tests/test_cancellation.py b/tests/test_cancellation.py
new file mode 100644
index 0000000..34b6b66
--- /dev/null
+++ b/tests/test_cancellation.py
@@ -0,0 +1,132 @@
+import unittest
+
+from relayboard.service import RunAlreadyTerminal
+from relayboard.testing import request
+from relayboard.web import create_seeded_app
+
+
+class CancellationTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.app = create_seeded_app()
+
+    def cancel(self, run_id):
+        return request(self.app, "POST", f"/api/runs/{run_id}/cancel")
+
+    def test_cancel_manual_and_scheduled_runs_before_first_attempt(self):
+        for source in ("manual", "scheduled"):
+            with self.subTest(source=source):
+                run = self.app.store.create_run("daily-report", source)
+                code, payload = self.cancel(run.id)
+                self.assertEqual(code, 200)
+                self.assertEqual(payload["run"], {
+                    "id": run.id,
+                    "job_id": run.job_id,
+                    "source": source,
+                    "status": "cancelled",
+                })
+                self.assertEqual(self.app.store.list_attempts(run.id), [])
+        self.assertEqual(self.app.store.list_alerts(), [])
+
+    def test_cancel_between_retries_preserves_attempts_and_alerts(self):
+        run = self.app.service.begin_manual_run("daily-report")
+        self.assertEqual(
+            self.app.service.record_attempt(run.id, succeeded=False), "retry"
+        )
+        attempts = self.app.store.list_attempts(run.id)
+        alerts = self.app.store.list_alerts()
+
+        self.assertEqual(self.cancel(run.id)[0], 200)
+        for succeeded in (False, True):
+            with self.subTest(succeeded=succeeded):
+                code, payload = request(
+                    self.app, "POST", f"/api/runs/{run.id}/attempts",
+                    {"succeeded": succeeded},
+                )
+                self.assertEqual(code, 409)
+                self.assertIn("error", payload)
+                with self.assertRaises(RunAlreadyTerminal):
+                    self.app.service.record_attempt(run.id, succeeded=succeeded)
+
+        self.assertEqual(self.app.store.get_run(run.id).status, "cancelled")
+        self.assertEqual(self.app.store.list_attempts(run.id), attempts)
+        self.assertEqual(self.app.store.list_alerts(), alerts)
+
+    def test_repeated_cancellation_is_idempotent(self):
+        run = self.app.service.begin_manual_run("daily-report")
+        first = self.cancel(run.id)
+        self.assertEqual(first[0], 200)
+        self.assertEqual(self.cancel(run.id), first)
+        self.assertEqual(self.app.service.cancel_run(run.id).status, "cancelled")
+        self.assertEqual(self.app.store.list_alerts(), [])
+        self.assertEqual(self.app.store.list_attempts(run.id), [])
+
+    def test_cancel_terminal_runs_is_conflict_and_preserves_records(self):
+        for succeeded in (False, True):
+            with self.subTest(succeeded=succeeded):
+                run = self.app.service.begin_manual_run("cleanup")
+                self.app.service.record_attempt(run.id, succeeded=succeeded)
+                terminal_run = self.app.store.get_run(run.id)
+                attempts = self.app.store.list_attempts(run.id)
+                alerts = self.app.store.list_alerts()
+
+                code, payload = self.cancel(run.id)
+                self.assertEqual(code, 409)
+                self.assertIn("error", payload)
+                with self.assertRaises(RunAlreadyTerminal):
+                    self.app.service.cancel_run(run.id)
+                self.assertEqual(self.app.store.get_run(run.id), terminal_run)
+                self.assertEqual(self.app.store.list_attempts(run.id), attempts)
+                self.assertEqual(self.app.store.list_alerts(), alerts)
+
+    def test_missing_run_is_not_found(self):
+        code, payload = self.cancel("missing")
+        self.assertEqual(code, 404)
+        self.assertEqual(payload, {"error": "not found: missing"})
+
+    def test_cancelled_run_is_latest_dashboard_result(self):
+        previous = self.app.service.begin_manual_run("daily-report")
+        self.app.service.record_attempt(previous.id, succeeded=True)
+        cancelled = self.app.service.begin_scheduled_run("daily-report")
+        self.cancel(cancelled.id)
+        self.app.service.begin_manual_run("daily-report")
+
+        self.assertEqual(
+            self.app.store.last_result_for_job("daily-report"), "cancelled"
+        )
+        code, markup = request(self.app, "GET", "/dashboard")
+        self.assertEqual(code, 200)
+        self.assertIn(
+            "<td>Daily report</td><td>yes</td><td>cancelled</td>", markup
+        )
+        self.assertEqual(self.app.store.last_result_for_job("cleanup"), None)
+
+    def test_cancelling_one_run_does_not_change_other_runs_or_retry_behavior(self):
+        cancelled = self.app.service.begin_manual_run("daily-report")
+        active = self.app.service.begin_scheduled_run("daily-report")
+        self.cancel(cancelled.id)
+        self.assertTrue(self.app.store.get_job("daily-report").enabled)
+        self.assertEqual(self.app.store.get_run(active.id).status, "running")
+        self.assertEqual(
+            self.app.service.record_attempt(active.id, succeeded=False), "retry"
+        )
+        self.assertEqual(len(self.app.store.list_alerts()), 1)
+        self.assertEqual(
+            self.app.service.record_attempt(active.id, succeeded=False), "failed"
+        )
+        self.assertEqual(len(self.app.store.list_alerts()), 2)
+        self.assertEqual(len(self.app.store.list_attempts(active.id)), 2)
+        self.assertEqual(self.app.store.get_run(cancelled.id).status, "cancelled")
+
+    def test_cancel_route_requires_post_and_exact_path(self):
+        run = self.app.service.begin_manual_run("daily-report")
+        for method, path in (
+            ("GET", f"/api/runs/{run.id}/cancel"),
+            ("POST", f"/api/runs/{run.id}/extra/cancel"),
+        ):
+            with self.subTest(method=method, path=path):
+                self.assertEqual(request(self.app, method, path)[0], 404)
+        self.assertEqual(self.app.store.get_run(run.id).status, "running")
+
+
+if __name__ == "__main__":
+    unittest.main()
