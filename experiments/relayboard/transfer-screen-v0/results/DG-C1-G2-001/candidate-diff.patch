diff --git a/tests/test_cancellation.py b/tests/test_cancellation.py
new file mode 100644
index 0000000..d2ac348
--- /dev/null
+++ b/tests/test_cancellation.py
@@ -0,0 +1,128 @@
+import unittest
+
+from relayboard.service import RunAlreadyTerminal
+from relayboard.testing import request
+from relayboard.web import create_seeded_app
+
+
+class CancellationTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.app = create_seeded_app()
+
+    def cancel(self, run_id):
+        return request(self.app, "POST", f"/api/runs/{run_id}/cancel")
+
+    def test_running_manual_and_scheduled_runs_can_be_cancelled(self) -> None:
+        for source in ("manual", "scheduled"):
+            with self.subTest(source=source):
+                code, payload = request(
+                    self.app, "POST", "/api/jobs/daily-report/runs",
+                    {"source": source},
+                )
+                self.assertEqual(code, 201)
+                original = payload["run"]
+                code, payload = self.cancel(original["id"])
+                self.assertEqual(code, 200)
+                self.assertEqual(
+                    payload["run"], {**original, "status": "cancelled"}
+                )
+                self.assertEqual(self.app.store.list_attempts(original["id"]), [])
+                self.assertEqual(self.app.store.list_alerts(), [])
+
+    def test_cancelled_run_rejects_both_attempt_outcomes(self) -> None:
+        run = self.app.service.begin_manual_run("daily-report")
+        self.app.service.cancel_run(run.id)
+
+        for succeeded in (True, False):
+            with self.subTest(succeeded=succeeded):
+                with self.assertRaises(RunAlreadyTerminal):
+                    self.app.service.record_attempt(run.id, succeeded=succeeded)
+                code, payload = request(
+                    self.app, "POST", f"/api/runs/{run.id}/attempts",
+                    {"succeeded": succeeded},
+                )
+                self.assertEqual(code, 409)
+                self.assertIn("error", payload)
+
+        self.assertEqual(self.app.store.get_run(run.id).status, "cancelled")
+        self.assertEqual(self.app.store.list_attempts(run.id), [])
+        self.assertEqual(self.app.store.list_alerts(), [])
+
+    def test_repeated_cancellation_is_idempotent(self) -> None:
+        run = self.app.service.begin_manual_run("daily-report")
+        first = self.cancel(run.id)
+        self.assertEqual(first[0], 200)
+        self.assertEqual(self.cancel(run.id), first)
+        self.assertEqual(self.app.store.list_alerts(), [])
+
+    def test_completed_runs_cannot_be_cancelled(self) -> None:
+        for succeeded in (True, False):
+            with self.subTest(succeeded=succeeded):
+                run = self.app.service.begin_manual_run("cleanup")
+                self.app.service.record_attempt(run.id, succeeded=succeeded)
+                original = self.app.store.get_run(run.id)
+                attempts = self.app.store.list_attempts(run.id)
+                alerts = self.app.store.list_alerts()
+
+                with self.assertRaises(RunAlreadyTerminal):
+                    self.app.service.cancel_run(run.id)
+                code, payload = self.cancel(run.id)
+                self.assertEqual(code, 409)
+                self.assertIn("error", payload)
+                self.assertEqual(self.app.store.get_run(run.id), original)
+                self.assertEqual(self.app.store.list_attempts(run.id), attempts)
+                self.assertEqual(self.app.store.list_alerts(), alerts)
+
+    def test_unknown_run_returns_404(self) -> None:
+        code, payload = self.cancel("missing")
+        self.assertEqual(code, 404)
+        self.assertEqual(payload, {"error": "not found: missing"})
+
+    def test_cancel_after_retry_preserves_existing_attempt_and_alert(self) -> None:
+        run = self.app.service.begin_manual_run("daily-report")
+        self.assertEqual(
+            self.app.service.record_attempt(run.id, succeeded=False), "retry"
+        )
+        attempts = self.app.store.list_attempts(run.id)
+        alerts = self.app.store.list_alerts()
+        self.assertEqual(len(alerts), 1)
+
+        self.assertEqual(self.cancel(run.id)[0], 200)
+        code, _ = request(
+            self.app, "POST", f"/api/runs/{run.id}/attempts",
+            {"succeeded": False},
+        )
+        self.assertEqual(code, 409)
+        self.assertEqual(self.app.store.list_attempts(run.id), attempts)
+        self.assertEqual(self.app.store.list_alerts(), alerts)
+
+    def test_cancellation_is_latest_dashboard_result(self) -> None:
+        previous = self.app.service.begin_manual_run("daily-report")
+        self.app.service.record_attempt(previous.id, succeeded=True)
+        run = self.app.service.begin_manual_run("daily-report")
+        self.assertEqual(self.app.store.last_result_for_job(run.job_id), "succeeded")
+        self.app.service.cancel_run(run.id)
+
+        self.assertEqual(self.app.store.last_result_for_job(run.job_id), "cancelled")
+        code, dashboard = request(self.app, "GET", "/dashboard")
+        self.assertEqual(code, 200)
+        self.assertIn("<td>Daily report</td><td>yes</td><td>cancelled</td>", dashboard)
+
+    def test_other_and_future_runs_keep_retry_and_alert_behavior(self) -> None:
+        cancelled = self.app.service.begin_manual_run("daily-report")
+        other = self.app.service.begin_manual_run("daily-report")
+        self.app.service.cancel_run(cancelled.id)
+        for run in (other, self.app.service.begin_scheduled_run("daily-report")):
+            self.assertEqual(
+                self.app.service.record_attempt(run.id, succeeded=False), "retry"
+            )
+            self.assertEqual(
+                self.app.service.record_attempt(run.id, succeeded=False), "failed"
+            )
+            self.assertEqual(len(self.app.store.list_attempts(run.id)), 2)
+        self.assertEqual(len(self.app.store.list_alerts()), 4)
+        self.assertTrue(self.app.store.get_job("daily-report").enabled)
+
+
+if __name__ == "__main__":
+    unittest.main()
