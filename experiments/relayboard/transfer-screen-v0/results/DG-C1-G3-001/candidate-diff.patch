diff --git a/tests/test_cancellation.py b/tests/test_cancellation.py
new file mode 100644
index 0000000..02830b1
--- /dev/null
+++ b/tests/test_cancellation.py
@@ -0,0 +1,172 @@
+import sqlite3
+import unittest
+from unittest.mock import patch
+
+from relayboard import RunAlreadyTerminal, Store
+from relayboard.testing import request
+from relayboard.web import create_seeded_app
+
+
+class CancellationTests(unittest.TestCase):
+    def setUp(self):
+        self.app = create_seeded_app()
+
+    def cancel(self, run_id):
+        return request(self.app, "POST", f"/api/runs/{run_id}/cancel")
+
+    def test_cancellation_is_idempotent_for_both_run_sources(self):
+        for source in ("manual", "scheduled"):
+            with self.subTest(source=source):
+                run = self.app.store.create_run("daily-report", source)
+                code, payload = self.cancel(run.id)
+                self.assertEqual(code, 200)
+                self.assertEqual(payload["run"], {
+                    "id": run.id, "job_id": run.job_id,
+                    "source": source, "status": "cancelled",
+                })
+                self.assertEqual(self.cancel(run.id), (code, payload))
+                self.assertEqual(self.app.store.list_attempts(run.id), [])
+        self.assertEqual(self.app.store.list_alerts(), [])
+
+    def test_cancellation_blocks_both_attempt_outcomes_at_all_entry_points(self):
+        run = self.app.service.begin_manual_run("daily-report")
+        self.app.service.cancel_run(run.id)
+        for succeeded in (True, False):
+            with self.subTest(succeeded=succeeded):
+                code, body = request(
+                    self.app, "POST", f"/api/runs/{run.id}/attempts",
+                    {"succeeded": succeeded},
+                )
+                self.assertEqual(code, 409)
+                self.assertIn("error", body)
+                with self.assertRaises(RunAlreadyTerminal):
+                    self.app.service.record_attempt(run.id, succeeded=succeeded)
+                with self.assertRaises(RunAlreadyTerminal):
+                    self.app.store.add_attempt(run.id, succeeded)
+        self.assertEqual(self.app.store.list_attempts(run.id), [])
+        self.assertEqual(self.app.store.list_alerts(), [])
+
+    def test_cancel_between_attempts_preserves_attempt_and_alert_history(self):
+        run = self.app.service.begin_manual_run("daily-report")
+        self.assertEqual(self.app.service.record_attempt(run.id, succeeded=False), "retry")
+        attempts = self.app.store.list_attempts(run.id)
+        alerts = self.app.store.list_alerts()
+        self.assertEqual(self.cancel(run.id)[0], 200)
+        self.assertEqual(self.cancel(run.id)[0], 200)
+        self.assertEqual(self.app.store.list_attempts(run.id), attempts)
+        self.assertEqual(self.app.store.list_alerts(), alerts)
+
+    def test_cancellation_after_service_state_read_still_blocks_recording(self):
+        run = self.app.service.begin_manual_run("daily-report")
+        add_attempt = self.app.store.add_attempt
+
+        def cancel_before_insert(run_id, succeeded):
+            self.app.service.cancel_run(run_id)
+            return add_attempt(run_id, succeeded)
+
+        with patch.object(self.app.store, "add_attempt", side_effect=cancel_before_insert):
+            code, _ = request(
+                self.app, "POST", f"/api/runs/{run.id}/attempts", {"succeeded": True}
+            )
+        self.assertEqual(code, 409)
+        self.assertEqual(self.app.store.get_run(run.id).status, "cancelled")
+        self.assertEqual(self.app.store.list_attempts(run.id), [])
+        self.assertEqual(self.app.store.list_alerts(), [])
+
+    def test_completed_runs_conflict_and_keep_history(self):
+        for succeeded in (True, False):
+            with self.subTest(succeeded=succeeded):
+                run = self.app.service.begin_manual_run("cleanup")
+                self.app.service.record_attempt(run.id, succeeded=succeeded)
+                original = self.app.store.get_run(run.id)
+                attempts = self.app.store.list_attempts(run.id)
+                alerts = self.app.store.list_alerts()
+                self.assertEqual(self.cancel(run.id)[0], 409)
+                with self.assertRaises(RunAlreadyTerminal):
+                    self.app.service.cancel_run(run.id)
+                self.assertEqual(self.app.store.get_run(run.id), original)
+                self.assertEqual(self.app.store.list_attempts(run.id), attempts)
+                self.assertEqual(self.app.store.list_alerts(), alerts)
+
+    def test_cancelled_status_cannot_be_overwritten(self):
+        run = self.app.service.begin_manual_run("daily-report")
+        self.app.service.cancel_run(run.id)
+        for status in ("running", "succeeded", "failed"):
+            with self.subTest(status=status), self.assertRaises(RunAlreadyTerminal):
+                self.app.store.set_run_status(run.id, status)
+        self.assertEqual(self.app.store.get_run(run.id).status, "cancelled")
+
+    def test_dashboard_includes_cancelled_as_latest_terminal_result(self):
+        first = self.app.service.begin_manual_run("daily-report")
+        self.app.service.record_attempt(first.id, succeeded=True)
+        run = self.app.service.begin_manual_run("daily-report")
+        self.app.service.cancel_run(run.id)
+        self.app.service.begin_manual_run("daily-report")
+        self.assertEqual(self.app.store.last_result_for_job("daily-report"), "cancelled")
+        code, body = request(self.app, "GET", "/dashboard")
+        self.assertEqual(code, 200)
+        self.assertIn("<td>cancelled</td>", body)
+
+    def test_missing_run_and_non_post_paths(self):
+        self.assertEqual(self.cancel("absent"), (404, {"error": "not found: absent"}))
+        run = self.app.service.begin_manual_run("daily-report")
+        self.assertEqual(request(self.app, "GET", f"/api/runs/{run.id}/cancel")[0], 404)
+        self.assertEqual(self.cancel(f"{run.id}/extra")[0], 404)
+        self.assertEqual(self.app.store.get_run(run.id).status, "running")
+
+    def test_other_runs_and_retry_behavior_are_unchanged(self):
+        cancelled = self.app.service.begin_scheduled_run("daily-report")
+        active = self.app.service.begin_manual_run("daily-report")
+        self.app.service.cancel_run(cancelled.id)
+        self.assertEqual(self.app.service.record_attempt(active.id, succeeded=False), "retry")
+        self.assertEqual(self.app.service.record_attempt(active.id, succeeded=False), "failed")
+        self.assertEqual(len(self.app.store.list_alerts()), 2)
+        self.assertTrue(self.app.store.get_job("daily-report").enabled)
+        self.assertEqual(self.app.service.begin_scheduled_run("daily-report").status, "running")
+
+    def test_existing_database_migration_preserves_history_and_constraints(self):
+        connection = sqlite3.connect(":memory:")
+        connection.executescript("""
+            PRAGMA foreign_keys = ON;
+            CREATE TABLE jobs (
+                id TEXT PRIMARY KEY, name TEXT NOT NULL,
+                enabled INTEGER NOT NULL, max_attempts INTEGER NOT NULL
+            );
+            CREATE TABLE runs (
+                id TEXT PRIMARY KEY, job_id TEXT NOT NULL REFERENCES jobs(id),
+                source TEXT NOT NULL CHECK(source IN ('manual', 'scheduled')),
+                status TEXT NOT NULL CHECK(status IN ('running', 'succeeded', 'failed'))
+            );
+            CREATE TABLE attempts (
+                run_id TEXT NOT NULL REFERENCES runs(id), number INTEGER NOT NULL,
+                succeeded INTEGER NOT NULL, PRIMARY KEY (run_id, number)
+            );
+            CREATE TABLE alerts (
+                id INTEGER PRIMARY KEY AUTOINCREMENT,
+                run_id TEXT NOT NULL REFERENCES runs(id),
+                job_id TEXT NOT NULL REFERENCES jobs(id), kind TEXT NOT NULL,
+                message TEXT NOT NULL
+            );
+            INSERT INTO jobs VALUES ('job', 'Job', 1, 2);
+            INSERT INTO runs(rowid, id, job_id, source, status)
+                VALUES (7, 'run-001', 'job', 'manual', 'failed'),
+                       (9, 'run-002', 'job', 'scheduled', 'running');
+            INSERT INTO attempts VALUES ('run-001', 1, 0), ('run-002', 1, 0);
+            INSERT INTO alerts(run_id, job_id, kind, message)
+                VALUES ('run-001', 'job', 'run_failed', 'Existing alert');
+        """)
+        store = Store(connection)
+        self.assertEqual(connection.execute("PRAGMA foreign_keys").fetchone()[0], 1)
+        self.assertEqual(connection.execute("PRAGMA foreign_key_check").fetchall(), [])
+        self.assertEqual(connection.execute("SELECT rowid FROM runs ORDER BY rowid").fetchall()[0][0], 7)
+        self.assertEqual(len(store.list_attempts("run-002")), 1)
+        self.assertEqual(store.list_alerts()[0].message, "Existing alert")
+        store.set_run_status("run-002", "cancelled")
+        self.assertEqual(store.last_result_for_job("job"), "cancelled")
+        self.assertEqual(Store(connection).get_run("run-002").status, "cancelled")
+        with self.assertRaises(RunAlreadyTerminal):
+            store.add_attempt("run-002", True)
+
+
+if __name__ == "__main__":
+    unittest.main()
