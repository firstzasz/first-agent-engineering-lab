diff --git a/tests/test_cancellation.py b/tests/test_cancellation.py
new file mode 100644
index 0000000..a671906
--- /dev/null
+++ b/tests/test_cancellation.py
@@ -0,0 +1,112 @@
+import unittest
+
+from relayboard.service import RunAlreadyTerminal
+from relayboard.testing import request
+from relayboard.web import create_seeded_app
+
+
+class CancellationTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.app = create_seeded_app()
+
+    def test_cancel_is_idempotent_and_blocks_both_attempt_outcomes(self) -> None:
+        run = self.app.service.begin_manual_run("daily-report")
+
+        for _ in range(2):
+            code, payload = request(
+                self.app, "POST", f"/api/runs/{run.id}/cancel"
+            )
+            self.assertEqual(code, 200)
+            self.assertEqual(
+                payload["run"],
+                {**run.__dict__, "status": "cancelled"},
+            )
+
+        for succeeded in (True, False):
+            with self.assertRaises(RunAlreadyTerminal):
+                self.app.service.record_attempt(run.id, succeeded=succeeded)
+            code, payload = request(
+                self.app,
+                "POST",
+                f"/api/runs/{run.id}/attempts",
+                {"succeeded": succeeded},
+            )
+            self.assertEqual(code, 409)
+            self.assertIn("error", payload)
+
+        self.assertEqual(self.app.store.get_run(run.id).status, "cancelled")
+        self.assertEqual(self.app.store.list_attempts(run.id), [])
+        self.assertEqual(self.app.store.list_alerts(), [])
+
+    def test_cancel_between_attempts_preserves_history(self) -> None:
+        run = self.app.service.begin_scheduled_run("daily-report")
+        self.assertEqual(
+            self.app.service.record_attempt(run.id, succeeded=False), "retry"
+        )
+        attempts = self.app.store.list_attempts(run.id)
+        alerts = self.app.store.list_alerts()
+
+        self.app.service.cancel_run(run.id)
+        with self.assertRaises(RunAlreadyTerminal):
+            self.app.service.record_attempt(run.id, succeeded=False)
+
+        self.assertEqual(self.app.store.list_attempts(run.id), attempts)
+        self.assertEqual(self.app.store.list_alerts(), alerts)
+        self.assertEqual(self.app.store.get_run(run.id).source, "scheduled")
+        self.assertEqual(
+            self.app.store.last_result_for_job("daily-report"), "cancelled"
+        )
+        code, markup = request(self.app, "GET", "/dashboard")
+        self.assertEqual(code, 200)
+        self.assertIn("<td>cancelled</td>", markup)
+
+        next_run = self.app.service.begin_scheduled_run("daily-report")
+        self.assertEqual(
+            self.app.service.record_attempt(next_run.id, succeeded=False), "retry"
+        )
+        self.assertEqual(
+            self.app.service.record_attempt(next_run.id, succeeded=True), "succeeded"
+        )
+
+    def test_completed_runs_cannot_be_cancelled(self) -> None:
+        for succeeded in (True, False):
+            with self.subTest(succeeded=succeeded):
+                run = self.app.service.begin_manual_run("cleanup")
+                self.app.service.record_attempt(run.id, succeeded=succeeded)
+                completed = self.app.store.get_run(run.id)
+                attempts = self.app.store.list_attempts(run.id)
+                alerts = self.app.store.list_alerts()
+
+                with self.assertRaises(RunAlreadyTerminal):
+                    self.app.service.cancel_run(run.id)
+                code, payload = request(
+                    self.app, "POST", f"/api/runs/{run.id}/cancel", {}
+                )
+                self.assertEqual(code, 409)
+                self.assertIn("error", payload)
+                self.assertEqual(self.app.store.get_run(run.id), completed)
+                self.assertEqual(self.app.store.list_attempts(run.id), attempts)
+                self.assertEqual(self.app.store.list_alerts(), alerts)
+
+    def test_missing_run_is_not_found(self) -> None:
+        with self.assertRaises(KeyError):
+            self.app.service.cancel_run("missing")
+        code, payload = request(
+            self.app, "POST", "/api/runs/missing/cancel", {}
+        )
+        self.assertEqual(code, 404)
+        self.assertEqual(payload, {"error": "not found: missing"})
+
+    def test_cancel_requires_post_and_exact_route(self) -> None:
+        run = self.app.service.begin_manual_run("daily-report")
+        for method, path in (
+            ("GET", f"/api/runs/{run.id}/cancel"),
+            ("POST", f"/api/runs/{run.id}/extra/cancel"),
+        ):
+            code, _ = request(self.app, method, path)
+            self.assertEqual(code, 404)
+            self.assertEqual(self.app.store.get_run(run.id).status, "running")
+
+
+if __name__ == "__main__":
+    unittest.main()
