diff --git a/tests/test_archive.py b/tests/test_archive.py
new file mode 100644
index 0000000..5c73e51
--- /dev/null
+++ b/tests/test_archive.py
@@ -0,0 +1,160 @@
+import sqlite3
+import unittest
+
+from relayboard import JobArchived, JobNotSchedulable, Store
+from relayboard.testing import request
+from relayboard.web import create_seeded_app
+
+
+class ArchiveTests(unittest.TestCase):
+    def setUp(self):
+        self.app = create_seeded_app()
+
+    def test_archive_restore_are_idempotent_and_preserve_configuration(self):
+        for job_id in ("daily-report", "cleanup"):
+            with self.subTest(job_id=job_id):
+                original = self.app.store.get_job(job_id)
+                for action, archived in (("archive", True), ("restore", False)):
+                    for _ in range(2):
+                        code, payload = request(
+                            self.app, "POST", f"/api/jobs/{job_id}/{action}"
+                        )
+                        self.assertEqual(code, 200)
+                        self.assertEqual(payload["job"], {
+                            **original.__dict__, "archived": archived,
+                        })
+                self.assertEqual(self.app.store.get_job(job_id), original)
+
+    def test_archived_jobs_block_new_runs_without_creating_history(self):
+        self.app.service.archive_job("daily-report")
+        for source in ("manual", "scheduled"):
+            with self.subTest(source=source):
+                code, payload = request(
+                    self.app, "POST", "/api/jobs/daily-report/runs",
+                    {"source": source},
+                )
+                self.assertEqual(code, 409)
+                self.assertIn("archived", payload["error"])
+        for begin in (
+            self.app.service.begin_manual_run,
+            self.app.service.begin_scheduled_run,
+        ):
+            with self.assertRaises(JobArchived):
+                begin("daily-report")
+        self.assertEqual(self.app.store.next_run_id(), "run-001")
+        self.app.service.restore_job("daily-report")
+        self.assertEqual(
+            self.app.service.begin_scheduled_run("daily-report").id, "run-001"
+        )
+
+    def test_restore_preserves_disabled_scheduling_and_manual_behavior(self):
+        self.app.service.archive_job("cleanup")
+        self.app.service.restore_job("cleanup")
+        with self.assertRaises(JobNotSchedulable):
+            self.app.service.begin_scheduled_run("cleanup")
+        self.assertEqual(
+            self.app.service.begin_manual_run("cleanup").source, "manual"
+        )
+
+    def test_enabled_updates_while_archived_do_not_reveal_or_allow_runs(self):
+        self.app.service.archive_job("cleanup")
+        code, payload = request(
+            self.app, "POST", "/api/jobs/cleanup/enabled", {"enabled": True}
+        )
+        self.assertEqual(code, 200)
+        self.assertTrue(payload["job"]["enabled"])
+        self.assertTrue(payload["job"]["archived"])
+        self.assertNotIn("cleanup", [j.id for j in self.app.store.list_jobs()])
+        with self.assertRaises(JobArchived):
+            self.app.service.begin_scheduled_run("cleanup")
+        self.app.service.restore_job("cleanup")
+        self.assertEqual(
+            self.app.service.begin_scheduled_run("cleanup").source, "scheduled"
+        )
+
+    def test_existing_runs_retries_alerts_and_history_survive_archiving(self):
+        previous = self.app.service.begin_manual_run("daily-report")
+        self.app.service.record_attempt(previous.id, succeeded=True)
+        active = self.app.service.begin_scheduled_run("daily-report")
+        previous_attempts = self.app.store.list_attempts(previous.id)
+        self.app.service.archive_job("daily-report")
+        self.assertEqual(self.app.store.get_run(previous.id).status, "succeeded")
+        self.assertEqual(self.app.store.list_attempts(previous.id), previous_attempts)
+        for succeeded, expected in ((False, "retry"), (False, "failed")):
+            code, payload = request(
+                self.app, "POST", f"/api/runs/{active.id}/attempts",
+                {"succeeded": succeeded},
+            )
+            self.assertEqual(code, 200)
+            self.assertEqual(payload["status"], expected)
+        self.assertEqual(len(self.app.store.list_attempts(active.id)), 2)
+        # Preserve the fixture's existing alert behavior, including retries.
+        alerts = self.app.store.list_alerts()
+        self.assertEqual([a.run_id for a in alerts], [active.id, active.id])
+        self.app.service.restore_job("daily-report")
+        self.assertEqual(self.app.store.list_alerts(), alerts)
+        self.assertEqual(self.app.store.last_result_for_job("daily-report"), "failed")
+        code, dashboard = request(self.app, "GET", "/dashboard")
+        self.assertEqual(code, 200)
+        self.assertIn("Daily report", dashboard)
+        self.assertIn("failed", dashboard)
+
+    def test_archived_discovery_is_explicit_and_does_not_change_dashboard(self):
+        self.app.service.archive_job("daily-report")
+        self.assertEqual([j.id for j in self.app.store.list_jobs()], ["cleanup"])
+        for query in ("", "?include_archived=false", "?include_archived=anything"):
+            code, payload = request(self.app, "GET", "/api/jobs" + query)
+            self.assertEqual(code, 200)
+            self.assertEqual([j["id"] for j in payload["jobs"]], ["cleanup"])
+        code, payload = request(
+            self.app, "GET", "/api/jobs?include_archived=true"
+        )
+        self.assertEqual(code, 200)
+        self.assertEqual([j["id"] for j in payload["jobs"]], ["cleanup", "daily-report"])
+        self.assertTrue(payload["jobs"][1]["archived"])
+        code, dashboard = request(self.app, "GET", "/dashboard?include_archived=true")
+        self.assertEqual(code, 200)
+        self.assertNotIn("Daily report", dashboard)
+
+    def test_missing_ids_and_malformed_routes_do_not_mutate_jobs(self):
+        for action in ("archive", "restore"):
+            for path in (
+                f"/api/jobs/missing/{action}",
+                f"/api/jobs/daily-report/extra/{action}",
+                f"/api/jobs//{action}",
+            ):
+                with self.subTest(path=path):
+                    self.assertEqual(request(self.app, "POST", path)[0], 404)
+            self.assertEqual(
+                request(self.app, "GET", f"/api/jobs/daily-report/{action}")[0],
+                404,
+            )
+        self.assertFalse(self.app.store.get_job("daily-report").archived)
+
+    def test_legacy_database_migrates_and_archive_survives_store_reopen(self):
+        connection = sqlite3.connect(":memory:")
+        self.addCleanup(connection.close)
+        connection.execute(
+            "CREATE TABLE jobs (id TEXT PRIMARY KEY, name TEXT NOT NULL, "
+            "enabled INTEGER NOT NULL, max_attempts INTEGER NOT NULL)"
+        )
+        connection.execute("INSERT INTO jobs VALUES ('old', 'Old job', 0, 3)")
+        connection.commit()
+        store = Store(connection)
+        self.assertFalse(store.get_job("old").archived)
+        run = store.create_run("old", "manual")
+        store.add_attempt(run.id, True)
+        store.set_run_status(run.id, "succeeded")
+        store.set_job_archived("old", True)
+        reopened = Store(connection)
+        self.assertTrue(reopened.get_job("old").archived)
+        self.assertEqual(reopened.list_jobs(), [])
+        self.assertEqual(reopened.get_run(run.id).status, "succeeded")
+        self.assertEqual(len(reopened.list_attempts(run.id)), 1)
+        restored = reopened.set_job_archived("old", False)
+        self.assertFalse(restored.enabled)
+        self.assertEqual(restored.max_attempts, 3)
+
+
+if __name__ == "__main__":
+    unittest.main()
