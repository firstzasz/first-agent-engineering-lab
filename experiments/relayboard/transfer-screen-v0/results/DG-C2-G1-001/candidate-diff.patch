diff --git a/tests/test_archive.py b/tests/test_archive.py
new file mode 100644
index 0000000..57f1b7a
--- /dev/null
+++ b/tests/test_archive.py
@@ -0,0 +1,154 @@
+import sqlite3
+import unittest
+
+from relayboard.service import JobNotSchedulable
+from relayboard.store import Store
+from relayboard.testing import request
+from relayboard.web import create_seeded_app
+
+
+class ArchiveJobTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.app = create_seeded_app()
+
+    def test_new_runs_blocked_while_archived_and_resume_after_restore(self) -> None:
+        request(self.app, "POST", "/api/jobs/daily-report/archive")
+        for source in ("manual", "scheduled"):
+            with self.subTest(source=source):
+                code, payload = request(
+                    self.app, "POST", "/api/jobs/daily-report/runs",
+                    {"source": source},
+                )
+                self.assertEqual(code, 409)
+                self.assertIn("archived", payload["error"])
+        self.assertEqual(self.app.store.next_run_id(), "run-001")
+
+        request(self.app, "POST", "/api/jobs/daily-report/restore")
+        for source in ("manual", "scheduled"):
+            with self.subTest(source=source):
+                code, _ = request(
+                    self.app, "POST", "/api/jobs/daily-report/runs",
+                    {"source": source},
+                )
+                self.assertEqual(code, 201)
+
+    def test_existing_run_retries_alerts_and_history_survive_archive(self) -> None:
+        service = self.app.service
+        run = service.begin_manual_run("daily-report")
+        service.archive_job("daily-report")
+        self.assertEqual(service.record_attempt(run.id, succeeded=False), "retry")
+        self.assertEqual(service.record_attempt(run.id, succeeded=False), "failed")
+        self.assertEqual(self.app.store.get_run(run.id).status, "failed")
+        self.assertEqual(len(self.app.store.list_attempts(run.id)), 2)
+        # Preserve the existing alert behavior for every failed attempt.
+        self.assertEqual(len(self.app.store.list_alerts()), 2)
+
+        service.restore_job("daily-report")
+        self.assertEqual(self.app.store.get_run(run.id).status, "failed")
+        self.assertEqual(len(self.app.store.list_attempts(run.id)), 2)
+        code, body = request(self.app, "GET", "/dashboard")
+        self.assertEqual(code, 200)
+        self.assertIn("failed", body)
+
+    def test_terminal_history_and_alerts_remain_accessible_while_archived(self) -> None:
+        run = self.app.service.begin_manual_run("cleanup")
+        self.app.service.record_attempt(run.id, succeeded=False)
+        attempts = self.app.store.list_attempts(run.id)
+        alerts = self.app.store.list_alerts()
+        self.app.service.archive_job("cleanup")
+        self.assertEqual(self.app.store.get_run(run.id).status, "failed")
+        self.assertEqual(self.app.store.list_attempts(run.id), attempts)
+        self.assertEqual(self.app.store.list_alerts(), alerts)
+        code, payload = request(self.app, "GET", "/api/alerts")
+        self.assertEqual(code, 200)
+        self.assertEqual(payload["alerts"][0]["run_id"], run.id)
+
+    def test_repeat_transitions_preserve_enabled_state_and_configuration(self) -> None:
+        for job_id in ("daily-report", "cleanup"):
+            with self.subTest(job_id=job_id):
+                original = self.app.store.get_job(job_id)
+                for _ in range(2):
+                    code, payload = request(
+                        self.app, "POST", f"/api/jobs/{job_id}/archive",
+                    )
+                    self.assertEqual(code, 200)
+                    self.assertTrue(payload["job"]["archived"])
+                    self.assertEqual(payload["job"]["enabled"], original.enabled)
+                for _ in range(2):
+                    code, payload = request(
+                        self.app, "POST", f"/api/jobs/{job_id}/restore",
+                    )
+                    self.assertEqual(code, 200)
+                    self.assertFalse(payload["job"]["archived"])
+                self.assertEqual(self.app.store.get_job(job_id), original)
+        with self.assertRaises(JobNotSchedulable):
+            self.app.service.begin_scheduled_run("cleanup")
+        self.assertEqual(self.app.service.begin_manual_run("cleanup").source, "manual")
+
+    def test_enable_update_while_archived_is_a_conflict(self) -> None:
+        for job_id in ("daily-report", "cleanup"):
+            with self.subTest(job_id=job_id):
+                original = self.app.store.get_job(job_id)
+                self.app.service.archive_job(job_id)
+                code, _ = request(
+                    self.app, "POST", f"/api/jobs/{job_id}/enabled",
+                    {"enabled": not original.enabled},
+                )
+                self.assertEqual(code, 409)
+                self.app.service.restore_job(job_id)
+                self.assertEqual(self.app.store.get_job(job_id), original)
+                code, _ = request(
+                    self.app, "POST", f"/api/jobs/{job_id}/enabled",
+                    {"enabled": not original.enabled},
+                )
+                self.assertEqual(code, 200)
+
+    def test_unknown_job_and_malformed_routes_return_404(self) -> None:
+        for action in ("archive", "restore"):
+            for path in (
+                f"/api/jobs/missing/{action}",
+                f"/api/jobs/daily-report/extra/{action}",
+            ):
+                with self.subTest(path=path):
+                    code, _ = request(self.app, "POST", path)
+                    self.assertEqual(code, 404)
+            code, _ = request(self.app, "GET", f"/api/jobs/daily-report/{action}")
+            self.assertEqual(code, 404)
+        self.assertFalse(self.app.store.get_job("daily-report").archived)
+
+    def test_archive_all_jobs_gives_empty_normal_views(self) -> None:
+        for job in self.app.store.list_jobs():
+            self.app.service.archive_job(job.id)
+        code, payload = request(self.app, "GET", "/api/jobs")
+        self.assertEqual(code, 200)
+        self.assertEqual(payload["jobs"], [])
+        self.assertEqual(len(self.app.store.list_jobs(include_archived=True)), 2)
+        code, body = request(self.app, "GET", "/dashboard")
+        self.assertEqual(code, 200)
+        self.assertNotIn("Daily report", body)
+        self.assertNotIn("Cleanup", body)
+
+    def test_legacy_database_migration_preserves_data_and_archive_state(self) -> None:
+        connection = sqlite3.connect(":memory:")
+        self.addCleanup(connection.close)
+        connection.executescript(
+            "CREATE TABLE jobs (id TEXT PRIMARY KEY, name TEXT NOT NULL, "
+            "enabled INTEGER NOT NULL, max_attempts INTEGER NOT NULL);"
+            "INSERT INTO jobs VALUES ('legacy', 'Legacy', 0, 2);"
+        )
+        store = Store(connection)
+        self.assertFalse(store.get_job("legacy").archived)
+        run = store.create_run("legacy", "manual")
+        store.set_job_archived("legacy", True)
+
+        reopened = Store(connection)
+        self.assertTrue(reopened.get_job("legacy").archived)
+        self.assertFalse(reopened.get_job("legacy").enabled)
+        self.assertEqual(reopened.list_jobs(), [])
+        self.assertEqual(reopened.get_run(run.id), run)
+        reopened.set_job_archived("legacy", False)
+        self.assertEqual(reopened.list_jobs()[0].max_attempts, 2)
+
+
+if __name__ == "__main__":
+    unittest.main()
