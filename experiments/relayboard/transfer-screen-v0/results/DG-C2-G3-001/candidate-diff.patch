diff --git a/tests/test_archive_lifecycle.py b/tests/test_archive_lifecycle.py
new file mode 100644
index 0000000..e56a923
--- /dev/null
+++ b/tests/test_archive_lifecycle.py
@@ -0,0 +1,143 @@
+import sqlite3
+import unittest
+
+from relayboard.service import JobArchived, JobNotSchedulable
+from relayboard.store import Store
+from relayboard.testing import request
+from relayboard.web import create_seeded_app
+
+
+class ArchiveLifecycleTests(unittest.TestCase):
+    def setUp(self):
+        self.app = create_seeded_app()
+
+    def transition(self, job_id, action):
+        return request(self.app, 'POST', f'/api/jobs/{job_id}/{action}')
+
+    def test_new_jobs_visible_and_unarchived(self):
+        code, payload = request(self.app, 'GET', '/api/jobs')
+        self.assertEqual(code, 200)
+        self.assertEqual([j['id'] for j in payload['jobs']], ['cleanup', 'daily-report'])
+        self.assertTrue(all(j['archived'] is False for j in payload['jobs']))
+
+    def test_transitions_are_idempotent_and_preserve_configuration(self):
+        for job_id in ('cleanup', 'daily-report'):
+            with self.subTest(job_id=job_id):
+                before = self.app.store.get_job(job_id)
+                for action, archived in (('archive', True), ('archive', True),
+                                         ('restore', False), ('restore', False)):
+                    code, payload = self.transition(job_id, action)
+                    self.assertEqual(code, 200)
+                    self.assertEqual(payload['job'], {
+                        'id': before.id, 'name': before.name,
+                        'enabled': before.enabled, 'max_attempts': before.max_attempts,
+                        'archived': archived,
+                    })
+                self.assertEqual(self.app.store.get_job(job_id), before)
+
+    def test_unknown_transitions_return_404_without_changes(self):
+        before = self.app.store.list_jobs()
+        for action in ('archive', 'restore'):
+            self.assertEqual(self.transition('missing', action)[0], 404)
+        self.assertEqual(self.app.store.list_jobs(), before)
+
+    def test_transition_routes_require_exact_path(self):
+        for path in ('/api/jobs/daily-report/nested/archive',
+                     '/api/jobs/daily-report/archive/extra'):
+            self.assertEqual(request(self.app, 'POST', path)[0], 404)
+        self.assertFalse(self.app.store.get_job('daily-report').archived)
+
+    def test_archived_jobs_block_both_run_sources_without_creating_runs(self):
+        for job_id in ('cleanup', 'daily-report'):
+            self.transition(job_id, 'archive')
+            for source in ('manual', 'scheduled'):
+                code, payload = request(self.app, 'POST', f'/api/jobs/{job_id}/runs',
+                                        {'source': source})
+                self.assertEqual(code, 409)
+                self.assertIn('archived', payload['error'])
+            with self.assertRaises(JobArchived):
+                self.app.service.begin_manual_run(job_id)
+            with self.assertRaises(JobArchived):
+                self.app.service.begin_scheduled_run(job_id)
+        self.assertEqual(self.app.store.next_run_id(), 'run-001')
+
+    def test_enabled_edits_cannot_change_saved_state_while_archived(self):
+        for job_id in ('cleanup', 'daily-report'):
+            before = self.app.store.get_job(job_id)
+            self.transition(job_id, 'archive')
+            code, _ = request(self.app, 'POST', f'/api/jobs/{job_id}/enabled',
+                              {'enabled': not before.enabled})
+            self.assertEqual(code, 409)
+            self.transition(job_id, 'restore')
+            self.assertEqual(self.app.store.get_job(job_id), before)
+        self.app.service.begin_manual_run('cleanup')
+        with self.assertRaises(JobNotSchedulable):
+            self.app.service.begin_scheduled_run('cleanup')
+        self.app.service.begin_scheduled_run('daily-report')
+        code, _ = request(self.app, 'POST', '/api/jobs/cleanup/enabled', {'enabled': True})
+        self.assertEqual(code, 200)
+        self.app.service.begin_scheduled_run('cleanup')
+
+    def test_existing_run_retry_and_alert_behavior_is_unchanged(self):
+        control = create_seeded_app()
+        archived_run = self.app.service.begin_manual_run('daily-report')
+        control_run = control.service.begin_manual_run('daily-report')
+        self.transition('daily-report', 'archive')
+        for succeeded in (False, False):
+            code, result = request(self.app, 'POST', f'/api/runs/{archived_run.id}/attempts',
+                                   {'succeeded': succeeded})
+            expected = control.service.record_attempt(control_run.id, succeeded=succeeded)
+            self.assertEqual(code, 200)
+            self.assertEqual(result['status'], expected)
+        self.assertEqual(self.app.store.get_run(archived_run.id), control.store.get_run(control_run.id))
+        self.assertEqual(self.app.store.list_attempts(archived_run.id),
+                         control.store.list_attempts(control_run.id))
+        self.assertEqual(self.app.store.list_alerts(), control.store.list_alerts())
+        self.assertEqual(request(self.app, 'GET', '/api/alerts'),
+                         request(control, 'GET', '/api/alerts'))
+        self.transition('daily-report', 'restore')
+        self.assertEqual(self.app.store.last_result_for_job('daily-report'), 'failed')
+        self.assertIn('failed', request(self.app, 'GET', '/dashboard')[1])
+
+    def test_in_progress_success_and_history_survive_archive_restore(self):
+        run = self.app.service.begin_scheduled_run('daily-report')
+        self.transition('daily-report', 'archive')
+        code, result = request(self.app, 'POST', f'/api/runs/{run.id}/attempts',
+                               {'succeeded': True})
+        self.assertEqual(code, 200)
+        self.assertEqual(result['status'], 'succeeded')
+        before = self.app.store.get_run(run.id)
+        attempts = self.app.store.list_attempts(run.id)
+        self.transition('daily-report', 'restore')
+        self.assertEqual(self.app.store.get_run(run.id), before)
+        self.assertEqual(self.app.store.list_attempts(run.id), attempts)
+        self.assertEqual(self.app.store.list_alerts(), [])
+        self.assertEqual(self.app.store.last_result_for_job('daily-report'), 'succeeded')
+
+    def test_existing_schema_migration_and_persisted_archive_state(self):
+        connection = sqlite3.connect(':memory:')
+        self.addCleanup(connection.close)
+        connection.execute('CREATE TABLE jobs (id TEXT PRIMARY KEY, name TEXT NOT NULL, '
+                           'enabled INTEGER NOT NULL, max_attempts INTEGER NOT NULL)')
+        connection.execute("INSERT INTO jobs VALUES ('legacy', 'Legacy', 0, 3)")
+        connection.commit()
+        store = Store(connection)
+        before = store.get_job('legacy')
+        self.assertFalse(before.archived)
+        self.assertFalse(before.enabled)
+        self.assertEqual(before.max_attempts, 3)
+        run = store.create_run('legacy', 'manual')
+        store.add_attempt(run.id, True)
+        store.set_run_status(run.id, 'succeeded')
+        store.set_job_archived('legacy', True)
+        reopened = Store(connection)
+        self.assertTrue(reopened.get_job('legacy').archived)
+        self.assertEqual(reopened.list_jobs(), [])
+        self.assertEqual(reopened.get_run(run.id).status, 'succeeded')
+        self.assertEqual(len(reopened.list_attempts(run.id)), 1)
+        reopened.set_job_archived('legacy', False)
+        self.assertEqual(reopened.get_job('legacy'), before)
+
+
+if __name__ == '__main__':
+    unittest.main()
